{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(git diff *)",
      "Bash(git commit *)"
    ],
    "deny": ["Bash(git push *)", "Bash(rm -rf *)"]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  }
}
